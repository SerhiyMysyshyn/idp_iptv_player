<?xml version="1.0" encoding="utf-8"?>
<!--
  Long-press shortcuts on the launcher icon.

  `targetClass` is MainActivity rather than a dedicated activity: the app is single-activity, so
  the shortcut carries an extra that MainActivity reads and forwards to the nav graph.
-->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:shortcutId="favourites"
        android:enabled="true"
        android:icon="@drawable/ic_shortcut_favourites"
        android:shortcutShortLabel="@string/shortcut_favourites_short"
        android:shortcutLongLabel="@string/shortcut_favourites_long">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetPackage="com.serhiimysyshyn.devlightiptvclient"
            android:targetClass="com.serhiimysyshyn.devlightiptvclient.MainActivity">
            <extra
                android:name="destination"
                android:value="favourites" />
        </intent>
        <categories android:name="android.shortcut.conversation" />
    </shortcut>
</shortcuts>
